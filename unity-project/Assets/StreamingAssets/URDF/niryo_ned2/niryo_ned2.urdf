<?xml version="1.0"?>
<robot name="niryo_ned2">
  <!-- Niryo Ned2 - Static URDF for Unity -->
  <!-- Joint limits converted from degrees: safety_margin=0 -->

  <!-- Materials -->
  <material name="NiryoBlue">
    <color rgba="0.2 0.4 0.8 1"/>
  </material>
  <material name="NiryoGray">
    <color rgba="0.3 0.3 0.3 1"/>
  </material>
  <material name="NiryoWhite">
    <color rgba="0.9 0.9 0.9 1"/>
  </material>

  <!-- World link for grounding -->
  <link name="world"/>

  <joint name="joint_world" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base Link -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.008924 0.0001357 0.052392" rpy="0 0 0"/>
      <mass value="0.71142"/>
      <inertia ixx="0.0017" ixy="0.0" ixz="0.0" iyy="0.0017" iyz="0.0" izz="0.0032"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry>
        <mesh filename="meshes/ned2/stl/base_link.stl" scale="1 1 1"/>
      </geometry>
      <material name="NiryoBlue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry>
        <mesh filename="meshes/ned2/stl/base_link.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <!-- Shoulder Link -->
  <link name="shoulder_link">
    <inertial>
      <origin xyz="-0.031951 0.0080419 0.030675" rpy="0 0 0"/>
      <mass value="0.35056"/>
      <inertia ixx="0.00023875" ixy="0.0" ixz="0.0" iyy="0.00032638" iyz="0.0" izz="0.00030089"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <mesh filename="meshes/ned2/stl/shoulder_link.stl" scale="1 1 1"/>
      </geometry>
      <material name="NiryoWhite"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <mesh filename="meshes/ned2/stl/shoulder_link.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_1" type="revolute">
    <origin xyz="0 0 0.1013" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.0" upper="3.0" effort="10.0" velocity="10.0"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- Arm Link -->
  <link name="arm_link">
    <inertial>
      <origin xyz="-0.00096976 0.086432 0.0038832" rpy="0 3.1416 0"/>
      <mass value="1.0838"/>
      <inertia ixx="0.008194" ixy="0.00015602" ixz="-0.0" iyy="0.0011945" iyz="-0.00031298" izz="0.007915"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 3.1416 0"/>
      <geometry>
        <mesh filename="meshes/ned2/stl/arm_link.stl" scale="1 1 1"/>
      </geometry>
      <material name="NiryoWhite"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 3.1416 0"/>
      <geometry>
        <mesh filename="meshes/ned2/stl/arm_link.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_2" type="revolute">
    <origin xyz="0 0 0.065" rpy="1.5708 0 0"/>
    <parent link="shoulder_link"/>
    <child link="arm_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.8326" upper="0.6102" effort="10.0" velocity="8.0"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- Elbow Link -->
  <link name="elbow_link">
    <inertial>
      <origin xyz="-0.019703 0.037336 0" rpy="0 3.1416 0"/>
      <mass value="0.22126"/>
      <inertia ixx="0.00011754" ixy="-0.0000123" ixz="0.0" iyy="0.00020851" iyz="0.0" izz="0.00022753"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 3.1416 -1.5708"/>
      <geometry>
        <mesh filename="meshes/ned2/stl/elbow_link.stl" scale="1 1 1"/>
      </geometry>
      <material name="NiryoWhite"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 3.1416 -1.5708"/>
      <geometry>
        <mesh filename="meshes/ned2/stl/elbow_link.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_3" type="revolute">
    <origin xyz="0.012 0.221 0" rpy="0 0 1.5708"/>
    <parent link="arm_link"/>
    <child link="elbow_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.3401" upper="1.5700" effort="7.0" velocity="8.0"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- Forearm Link -->
  <link name="forearm_link">
    <inertial>
      <origin xyz="-0.0049532 0.0000078351 0.08106" rpy="0 0 0"/>
      <mass value="0.35686"/>
      <inertia ixx="0.0013664" ixy="0.0" ixz="0.00013594" iyy="0.0014781" iyz="0.0" izz="0.00023715"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <mesh filename="meshes/ned2/stl/forearm_link.stl" scale="1 1 1"/>
      </geometry>
      <material name="NiryoWhite"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <mesh filename="meshes/ned2/stl/forearm_link.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_4" type="revolute">
    <origin xyz="0.0325 -0.065 0" rpy="1.5708 0 0"/>
    <parent link="elbow_link"/>
    <child link="forearm_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0899" upper="2.0899" effort="7.0" velocity="2.0"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- Wrist Link -->
  <link name="wrist_link">
    <inertial>
      <origin xyz="-0.019666 0.037312 0.0" rpy="0 0 0"/>
      <mass value="0.22126"/>
      <inertia ixx="0.0015" ixy="0.0" ixz="0.0" iyy="0.0015" iyz="0.0" izz="0.0015"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <mesh filename="meshes/ned2/stl/wrist_link.stl" scale="1 1 1"/>
      </geometry>
      <material name="NiryoWhite"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <mesh filename="meshes/ned2/stl/wrist_link.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_5" type="revolute">
    <origin xyz="0 0 0.17" rpy="-1.5708 0 0"/>
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.9200" upper="1.9227" effort="6.0" velocity="2.0"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- Hand Link -->
  <link name="hand_link">
    <inertial>
      <origin xyz="0 0 0.009" rpy="0 0 0"/>
      <mass value="0.0070027"/>
      <inertia ixx="0.0015" ixy="0.0" ixz="0.0" iyy="0.0015" iyz="0.0" izz="0.0015"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <mesh filename="meshes/ned2/stl/hand_link.stl" scale="1 1 1"/>
      </geometry>
      <material name="NiryoGray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <mesh filename="meshes/ned2/stl/hand_link.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_6" type="revolute">
    <origin xyz="0.00925 -0.0197 0" rpy="1.5708 0 0"/>
    <parent link="wrist_link"/>
    <child link="hand_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.5300" upper="2.5300" effort="5.0" velocity="2.0"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- Tool Link (TCP) -->
  <link name="tool_link"/>

  <joint name="hand_tool_joint" type="fixed">
    <parent link="hand_link"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0.0285" rpy="3.1416 -1.5708 0"/>
  </joint>

</robot>
