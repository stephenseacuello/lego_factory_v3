<?xml version="1.0"?>
<robot name="lite6">
  <!-- xArm Lite 6 - Static URDF for Unity -->

  <!-- Materials -->
  <material name="White">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="Silver">
    <color rgba="0.75 0.75 0.75 1"/>
  </material>

  <!-- World link for grounding -->
  <link name="world"/>

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="link_base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base Link -->
  <link name="link_base">
    <inertial>
      <origin xyz="-0.00829544579053192 0.0000326357432323433 0.0631194584987089" rpy="0 0 0"/>
      <mass value="1.65393501783165"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/lite6/visual/link_base.stl" scale="1 1 1"/>
      </geometry>
      <material name="White"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/lite6/collision/link_base.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <!-- Link 1 -->
  <link name="link1">
    <inertial>
      <origin xyz="-0.00036 0.04195 -0.0025" rpy="0 0 0"/>
      <mass value="1.411"/>
      <inertia ixx="0.00145164" ixy="-0.0000124" ixz="0.0000067" iyy="0.0008873" iyz="-0.0001255" izz="0.00131993"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/lite6/visual/link1.stl" scale="1 1 1"/>
      </geometry>
      <material name="White"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/lite6/collision/link1.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.2435" rpy="0 0 0"/>
    <parent link="link_base"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185" upper="6.283185" effort="50.0" velocity="3.14"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- Link 2 -->
  <link name="link2">
    <inertial>
      <origin xyz="0.179 0.0 0.0584" rpy="0 0 0"/>
      <mass value="1.34"/>
      <inertia ixx="0.0015854" ixy="0.00000677" ixz="0.00115136" iyy="0.0056097" iyz="-0.00000114" izz="0.00485"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/lite6/visual/link2.stl" scale="1 1 1"/>
      </geometry>
      <material name="White"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/lite6/collision/link2.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0" rpy="1.5708 -1.5708 3.1416"/>
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.61799" upper="2.61799" effort="50.0" velocity="3.14"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- Link 3 -->
  <link name="link3">
    <inertial>
      <origin xyz="0.072 -0.0357 -0.001" rpy="0 0 0"/>
      <mass value="0.953"/>
      <inertia ixx="0.0008861" ixy="0.00039287" ixz="-0.00007066" iyy="0.0015785" iyz="0.00002445" izz="0.00184677"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/lite6/visual/link3.stl" scale="1 1 1"/>
      </geometry>
      <material name="White"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/lite6/collision/link3.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint3" type="revolute">
    <origin xyz="0.2002 0 0" rpy="-3.1416 0 1.5708"/>
    <parent link="link2"/>
    <child link="link3"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.061087" upper="5.235988" effort="32.0" velocity="3.14"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- Link 4 -->
  <link name="link4">
    <inertial>
      <origin xyz="-0.002 -0.0285 -0.0813" rpy="0 0 0"/>
      <mass value="1.284"/>
      <inertia ixx="0.003705" ixy="0.000002" ixz="-0.00000717" iyy="0.0030455" iyz="0.00093188" izz="0.0015413"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/lite6/visual/link4.stl" scale="1 1 1"/>
      </geometry>
      <material name="White"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/lite6/collision/link4.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint4" type="revolute">
    <origin xyz="0.087 -0.22761 0" rpy="1.5708 0 0"/>
    <parent link="link3"/>
    <child link="link4"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185" upper="6.283185" effort="32.0" velocity="3.14"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- Link 5 -->
  <link name="link5">
    <inertial>
      <origin xyz="0.0 0.01 0.0019" rpy="0 0 0"/>
      <mass value="0.804"/>
      <inertia ixx="0.0005668" ixy="-0.0000006" ixz="0.0000053" iyy="0.0005077" iyz="0.00000048" izz="0.00053"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/lite6/visual/link5.stl" scale="1 1 1"/>
      </geometry>
      <material name="White"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/lite6/collision/link5.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint5" type="revolute">
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <parent link="link4"/>
    <child link="link5"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.1642" upper="2.1642" effort="32.0" velocity="3.14"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- Link 6 (End Effector) -->
  <link name="link6">
    <inertial>
      <origin xyz="0.0 -0.00194 -0.0102" rpy="0 0 0"/>
      <mass value="0.13"/>
      <inertia ixx="0.00007726" ixy="-0.000001" ixz="-0.0000004" iyy="0.000085665" iyz="0.0000006" izz="0.00014814"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/lite6/visual/link6.stl" scale="1 1 1"/>
      </geometry>
      <material name="Silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/lite6/collision/link6.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint6" type="revolute">
    <origin xyz="0 0.0625 0" rpy="-1.5708 0 0"/>
    <parent link="link5"/>
    <child link="link6"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185" upper="6.283185" effort="20.0" velocity="3.14"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <!-- Tool Center Point -->
  <link name="link_tcp"/>

  <joint name="joint_tcp" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="link6"/>
    <child link="link_tcp"/>
  </joint>

</robot>
