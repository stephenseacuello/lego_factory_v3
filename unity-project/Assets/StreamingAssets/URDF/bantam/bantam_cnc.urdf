<?xml version="1.0"?>
<robot name="bantam_cnc">
  <!-- Bantam Tools Desktop CNC Milling Machine -->
  <!-- Single mesh model with work envelope simulation -->

  <!-- Materials -->
  <material name="BantamGray">
    <color rgba="0.3 0.3 0.32 1"/>
  </material>
  <material name="BantamBlue">
    <color rgba="0.2 0.4 0.7 1"/>
  </material>

  <!-- World link -->
  <link name="world"/>

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base/Frame - The main CNC body -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="bantam_cnc.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="BantamGray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="bantam_cnc.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- X Axis (Left-Right) - Simulated for animation -->
  <link name="x_carriage">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="BantamBlue"/>
    </visual>
  </link>

  <joint name="x_axis" type="prismatic">
    <parent link="base_link"/>
    <child link="x_carriage"/>
    <origin xyz="0 0.05 0.1" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.1" upper="0.1" effort="100" velocity="0.1"/>
  </joint>

  <!-- Y Axis (Front-Back) -->
  <link name="y_carriage">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="BantamBlue"/>
    </visual>
  </link>

  <joint name="y_axis" type="prismatic">
    <parent link="x_carriage"/>
    <child link="y_carriage"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.075" upper="0.075" effort="100" velocity="0.1"/>
  </joint>

  <!-- Z Axis (Up-Down) -->
  <link name="z_carriage">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="BantamBlue"/>
    </visual>
  </link>

  <joint name="z_axis" type="prismatic">
    <parent link="y_carriage"/>
    <child link="z_carriage"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.05" upper="0.05" effort="100" velocity="0.05"/>
  </joint>

  <!-- Spindle -->
  <link name="spindle">
    <visual>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.04"/>
      </geometry>
      <material name="BantamGray"/>
    </visual>
  </link>

  <joint name="spindle_joint" type="continuous">
    <parent link="z_carriage"/>
    <child link="spindle"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Tool -->
  <link name="tool">
    <visual>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.002" length="0.03"/>
      </geometry>
      <material name="BantamBlue"/>
    </visual>
  </link>

  <joint name="tool_joint" type="fixed">
    <parent link="spindle"/>
    <child link="tool"/>
    <origin xyz="0 0 -0.04" rpy="0 0 0"/>
  </joint>

</robot>
