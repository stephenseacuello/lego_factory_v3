        {
          "name": "cnc1_spindle_load",
          "node_id": "ns=2;s=Channel1.CNC1.SpindleLoad",
          "data_type": "Double",
          "description": "CNC spindle load",
          "engineering_unit": "%"
        },
        {
          "name": "cnc1_feed_rate",
          "node_id": "ns=2;s=Channel1.CNC1.FeedRate",
          "data_type": "Double",
          "description": "CNC feed rate",
          "engineering_unit": "mm/min"
        }
      ]
    },
