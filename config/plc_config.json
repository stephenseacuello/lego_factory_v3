{
  "connections": [
    {
      "name": "main_plc",
      "protocol": "modbus_tcp",
      "description": "Main factory PLC (Siemens S7-1200 via Modbus TCP)",
      "host": "192.168.1.100",
      "port": 502,
      "poll_interval": 1.0,
      "tags": [
        {
          "name": "conveyor_speed",
          "address": 0,
          "data_type": "float32",
          "function_code": 3,
          "description": "Main conveyor belt speed",
          "engineering_unit": "m/min",
          "scale_factor": 0.1,
          "offset": 0
        },
        {
          "name": "conveyor_running",
          "address": 100,
          "data_type": "bool",
          "function_code": 1,
          "description": "Conveyor motor running status"
        },
        {
          "name": "part_count",
          "address": 2,
          "data_type": "uint32",
          "function_code": 3,
          "description": "Total parts produced today"
        },
        {
          "name": "reject_count",
          "address": 4,
          "data_type": "uint32",
          "function_code": 3,
          "description": "Rejected parts count"
        },
        {
          "name": "ambient_temp",
          "address": 6,
          "data_type": "float32",
          "function_code": 4,
          "description": "Ambient temperature",
          "engineering_unit": "°C",
          "scale_factor": 0.1
        }
      ]
    },
    {
      "name": "vfd_extruder",
      "protocol": "modbus_tcp",
      "description": "Variable Frequency Drive for extruder motor",
      "host": "192.168.1.110",
      "port": 502,
      "poll_interval": 0.5,
      "tags": [
        {
          "name": "motor_speed",
          "address": 0,
          "data_type": "float32",
          "function_code": 3,
          "description": "Motor speed",
          "engineering_unit": "RPM",
          "scale_factor": 1.0
        },
        {
          "name": "motor_current",
          "address": 2,
          "data_type": "float32",
          "function_code": 3,
          "description": "Motor current draw",
          "engineering_unit": "A",
          "scale_factor": 0.01
        },
        {
          "name": "motor_torque",
          "address": 4,
          "data_type": "float32",
          "function_code": 3,
          "description": "Motor torque",
          "engineering_unit": "%",
          "scale_factor": 0.1
        },
        {
          "name": "speed_setpoint",
          "address": 100,
          "data_type": "float32",
          "function_code": 3,
          "description": "Speed setpoint",
          "engineering_unit": "RPM",
          "read_only": false
        },
        {
          "name": "drive_status",
          "address": 50,
          "data_type": "uint16",
          "function_code": 3,
          "description": "Drive status word"
        }
      ]
    },
    {
      "name": "temp_controller",
      "protocol": "modbus_rtu",
      "description": "Eurotherm temperature controller bank (RS-485)",
      "serial_port": "/dev/ttyUSB0",
      "baudrate": 9600,
      "parity": "N",
      "poll_interval": 2.0,
      "tags": [
        {
          "name": "zone1_pv",
          "address": 1,
          "unit_id": 1,
          "data_type": "float32",
          "function_code": 3,
          "description": "Zone 1 process value",
          "engineering_unit": "°C",
          "scale_factor": 0.1
        },
        {
          "name": "zone1_sp",
          "address": 3,
          "unit_id": 1,
          "data_type": "float32",
          "function_code": 3,
          "description": "Zone 1 setpoint",
          "engineering_unit": "°C",
          "scale_factor": 0.1,
          "read_only": false
        },
        {
          "name": "zone2_pv",
          "address": 1,
          "unit_id": 2,
          "data_type": "float32",
          "function_code": 3,
          "description": "Zone 2 process value",
          "engineering_unit": "°C",
          "scale_factor": 0.1
        },
        {
          "name": "zone2_sp",
          "address": 3,
          "unit_id": 2,
          "data_type": "float32",
          "function_code": 3,
          "description": "Zone 2 setpoint",
          "engineering_unit": "°C",
          "scale_factor": 0.1,
          "read_only": false
        },
        {
          "name": "zone3_pv",
          "address": 1,
          "unit_id": 3,
          "data_type": "float32",
          "function_code": 3,
          "description": "Zone 3 process value",
          "engineering_unit": "°C",
          "scale_factor": 0.1
        },
        {
          "name": "zone3_sp",
          "address": 3,
          "unit_id": 3,
          "data_type": "float32",
          "function_code": 3,
          "description": "Zone 3 setpoint",
          "engineering_unit": "°C",
          "scale_factor": 0.1,
          "read_only": false
        }
      ]
    },
    {
      "name": "siemens_s7_1500",
      "protocol": "opcua",
      "description": "Siemens S7-1500 PLC (native OPC-UA)",
      "endpoint_url": "opc.tcp://192.168.1.120:4840",
      "security_mode": "None",
      "security_policy": "None",
      "nodes": [
        {
          "name": "robot_cell_status",
          "node_id": "ns=3;s=\"Robot_Cell\".\"Status\"",
          "data_type": "Int32",
          "description": "Robot cell status code"
        },
        {
          "name": "robot_position_x",
          "node_id": "ns=3;s=\"Robot_Cell\".\"Position\".\"X\"",
          "data_type": "Double",
          "description": "Robot X position",
          "engineering_unit": "mm"
        },
        {
          "name": "robot_position_y",
          "node_id": "ns=3;s=\"Robot_Cell\".\"Position\".\"Y\"",
          "data_type": "Double",
          "description": "Robot Y position",
          "engineering_unit": "mm"
        },
        {
          "name": "robot_position_z",
          "node_id": "ns=3;s=\"Robot_Cell\".\"Position\".\"Z\"",
          "data_type": "Double",
          "description": "Robot Z position",
          "engineering_unit": "mm"
        },
        {
          "name": "gripper_state",
          "node_id": "ns=3;s=\"Robot_Cell\".\"Gripper\".\"State\"",
          "data_type": "Boolean",
          "description": "Gripper open/closed"
        },
        {
          "name": "cycle_time",
          "node_id": "ns=3;s=\"Production\".\"CycleTime\"",
          "data_type": "Double",
          "description": "Current cycle time",
          "engineering_unit": "s"
        },
        {
          "name": "oee_availability",
          "node_id": "ns=3;s=\"Production\".\"OEE\".\"Availability\"",
          "data_type": "Double",
          "description": "OEE Availability",
          "engineering_unit": "%",
          "scale_factor": 100
        },
        {
          "name": "oee_performance",
          "node_id": "ns=3;s=\"Production\".\"OEE\".\"Performance\"",
          "data_type": "Double",
          "description": "OEE Performance",
          "engineering_unit": "%",
          "scale_factor": 100
        },
        {
          "name": "oee_quality",
          "node_id": "ns=3;s=\"Production\".\"OEE\".\"Quality\"",
          "data_type": "Double",
          "description": "OEE Quality",
          "engineering_unit": "%",
          "scale_factor": 100
        }
      ]
    },
    {
      "name": "kepware",
      "protocol": "opcua",
      "description": "Kepware KEPServerEX gateway (aggregates legacy devices)",
      "endpoint_url": "opc.tcp://192.168.1.200:49320",
      "security_mode": "SignAndEncrypt",
      "security_policy": "Basic256Sha256",
      "username": "opcuser",
      "password": "",
      "nodes": [
        {
          "name": "printer1_status",
