# LEGO Factory v3 - Environment Configuration Template
# =====================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
#
# Generate secure secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# =============================================================================
# REQUIRED - Application Security
# =============================================================================
# Secret key for Flask session management and CSRF protection
# MUST be set in production - generate a secure random string (32+ chars)
SECRET_KEY=

# JWT secret for API authentication tokens
# MUST be set in production - generate a secure random string (32+ chars)
JWT_SECRET_KEY=

# =============================================================================
# REQUIRED - Database (PostgreSQL + TimescaleDB)
# =============================================================================
# Full database connection URL (preferred for Docker)
DATABASE_URL=postgresql://lego:YOUR_SECURE_PASSWORD@localhost:5432/lego_factory

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=lego
POSTGRES_PASSWORD=
POSTGRES_DB=lego_factory

# Alternative: Individual database connection parameters
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=lego_factory
# DB_USER=lego
# DB_PASSWORD=

# =============================================================================
# REQUIRED - Redis
# =============================================================================
REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=  # Uncomment and set if Redis requires authentication

# Celery broker URL (typically separate Redis DB)
CELERY_BROKER_URL=redis://localhost:6379/1

# =============================================================================
# Flask Configuration
# =============================================================================
FLASK_ENV=development
FLASK_DEBUG=0
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# =============================================================================
# MQTT Broker (Mosquitto)
# =============================================================================
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=lego_factory_app
# MQTT_USERNAME=
# MQTT_PASSWORD=

# =============================================================================
# Service URLs (Docker internal networking)
# =============================================================================
SLICER_SERVICE_URL=http://slicer:8766
ROS2_BRIDGE_URL=ws://ros2-novnc:9090

# =============================================================================
# Grafana Monitoring
# =============================================================================
GF_SECURITY_ADMIN_PASSWORD=

# =============================================================================
# Machine Control (Serial Ports)
# =============================================================================
# Update these based on your connected machines
TINYG_PORT=/dev/ttyUSB0
TINYG_BAUD=115200
GRBL_PORT=/dev/ttyUSB1
GRBL_BAUD=115200

# =============================================================================
# ROS2 Integration (Optional)
# =============================================================================
ROS2_ENABLED=false
ROS2_DOMAIN_ID=0
ROSBRIDGE_PORT=9090

# =============================================================================
# Robot Configuration (Optional)
# =============================================================================
# NED2_CONNECTION_TYPE: simulation | pyniryo | ros2
NED2_CONNECTION_TYPE=simulation
NED2_IP=192.168.1.100

# XARM_CONNECTION_TYPE: simulation | xarm_sdk | ros2
XARM_CONNECTION_TYPE=simulation
XARM_IP=192.168.1.101

# =============================================================================
# CORS Configuration (Production)
# =============================================================================
# Comma-separated list of allowed origins for production
# Leave empty to allow all origins (development only)
# Example: https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=

# =============================================================================
# AI/ML Services (Optional)
# =============================================================================
# Anthropic API key for Claude AI assistant features
# ANTHROPIC_API_KEY=

# ML model configuration
ML_MODEL_PATH=services/ml/checkpoints
ML_VOCAB_PATH=services/ml/dataset/vocabulary.json
ML_DEVICE=cpu
ML_BATCH_SIZE=32
ML_ANOMALY_THRESHOLD=0.8

# =============================================================================
# Historian Configuration (Optional)
# =============================================================================
HISTORIAN_BUFFER_SIZE=1000
HISTORIAN_FLUSH_INTERVAL=1.0
HISTORIAN_COMPRESSION_DEVIATION=0.01
HISTORIAN_COMPRESSION_MAX_TIME=60.0
HISTORIAN_RETENTION_RAW_DAYS=7
HISTORIAN_RETENTION_1MIN_DAYS=30
HISTORIAN_RETENTION_1HOUR_DAYS=365

# =============================================================================
# Alarm Configuration (Optional)
# =============================================================================
ALARM_MAX_UNACKED=1000
ALARM_SHELVE_MAX_HOURS=24
ALARM_RATE_LIMIT=100
ALARM_DEADBAND_PERCENT=1.0

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =============================================================================
# Email Notifications (Optional)
# =============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=

# =============================================================================
# Twilio SMS Notifications (Optional)
# =============================================================================
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
