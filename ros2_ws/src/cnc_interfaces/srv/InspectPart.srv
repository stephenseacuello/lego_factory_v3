# InspectPart.srv - Trigger visual part inspection
# Request part inspection and receive defect analysis

# Request
string part_number              # Part identifier for traceability
string part_type                # Part type for model selection
string[] expected_features      # Features to verify (e.g., ["holes", "chamfer", "threads"])
float32 confidence_threshold    # Min confidence (default 0.7)
bool capture_new_image          # True to capture, false to use latest frame
string camera_id                # Camera to use (default: primary)
string machine_id
---
# Response
bool success
string message

# Inspection results
VisionDetection[] defects       # Detected defects
string[] features_verified      # Features confirmed present
string[] features_missing       # Expected features not found

# Quality assessment
float32 quality_score           # 0-100 overall quality
bool passed                     # Pass/fail based on criteria
string disposition              # "accept", "rework", "scrap", "review"

# Defect summary
uint32 defect_count
uint32 minor_defects
uint32 major_defects
uint32 critical_defects

# Evidence
string image_path               # Path to inspection image
string annotated_image_path     # Image with defect annotations
string report_path              # Full inspection report

# Timing
float32 capture_time_ms
float32 inference_time_ms
float32 total_time_ms
