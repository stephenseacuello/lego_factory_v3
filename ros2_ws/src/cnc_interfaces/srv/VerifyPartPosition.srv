# VerifyPartPosition.srv - Verify part is correctly positioned in fixture
# Use before machining to ensure proper setup

# Request
string fixture_id               # Fixture identifier
string part_number              # Expected part
float32 expected_x              # Expected position (mm, optional)
float32 expected_y
float32 expected_rotation       # Degrees
float32 tolerance_position_mm   # Position tolerance (default 1.0)
float32 tolerance_rotation_deg  # Rotation tolerance (default 2.0)
bool capture_new_image
string camera_id
string machine_id
---
# Response
bool success
string message

# Position analysis
bool part_detected              # Part visible in fixture
bool position_correct           # Within tolerance
bool rotation_correct           # Within rotation tolerance

# Measured position
float32 detected_x              # Detected X position
float32 detected_y              # Detected Y position
float32 detected_rotation       # Detected rotation

# Deviations
float32 x_deviation_mm
float32 y_deviation_mm
float32 rotation_deviation_deg
float32 total_deviation_mm      # Euclidean distance

# Fixture status
bool fixture_empty              # No part detected
bool multiple_parts             # More than one part detected
bool obstruction_detected       # Foreign object in fixture

# Confidence
float32 detection_confidence
float32 position_confidence

# Recommendation
bool safe_to_machine
string recommendation           # "proceed", "adjust_x", "adjust_y", "rotate", "reposition", "clear_obstruction"

# Evidence
string image_path
string annotated_image_path
VisionDetection[] detections
float32 inference_time_ms
