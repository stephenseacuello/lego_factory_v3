# AllocateMachine.srv - Reserve a machine for exclusive use
# Used for maintenance, setup, or priority jobs

# Request
string machine_id
string requester_id               # Operator or system requesting
string reason                     # "maintenance", "setup", "priority_job", etc.
float32 duration_minutes          # Expected duration (0 = indefinite)
bool force                        # Override existing allocation
---
# Response
bool success
string message
string previous_allocation        # Who had it allocated (if any)
builtin_interfaces/Time expires_at
