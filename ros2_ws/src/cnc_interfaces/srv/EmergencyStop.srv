# EmergencyStop.srv - Emergency stop / reset

# Request
string machine_id

# Action type
uint8 ACTION_ESTOP = 0       # Emergency stop (halt all motion)
uint8 ACTION_FEED_HOLD = 1   # Controlled deceleration stop
uint8 ACTION_RESET = 2       # Soft reset controller
uint8 ACTION_UNLOCK = 3      # Clear alarm/unlock ($X in GRBL)
uint8 ACTION_RESUME = 4      # Resume from hold (~)

uint8 action

string reason ""  # Optional reason for logging
---
# Response
bool success
string message
string previous_state
string new_state
