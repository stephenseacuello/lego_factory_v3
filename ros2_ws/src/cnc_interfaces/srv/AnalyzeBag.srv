# AnalyzeBag.srv - Analyze ROS bag file

# Request
string bag_path
string[] topics               # Empty = all topics
uint8 analysis_type           # ANALYSIS_* from BagAnalytics.msg

# Time range (optional)
builtin_interfaces/Time start_time
builtin_interfaces/Time end_time

# Analysis options
bool detect_anomalies
bool find_correlations
bool generate_report
string report_format          # "json", "html", "pdf"
string output_path

---

# Response
bool success
string message
cnc_interfaces/BagAnalytics results
string report_path
float32 analysis_duration     # seconds
