# ProcessVoice.srv - Process voice command

# Request
string audio_data_base64      # Base64 encoded audio or empty
string transcript             # Pre-transcribed text (if available)
string session_id
string user_id
string preferred_language     # "en-US", "es-ES", etc.

---

# Response
bool success
string message
cnc_interfaces/VoiceCommand parsed_command
string response_text          # Text to speak back
string response_audio_base64  # TTS audio response
bool requires_confirmation
string confirmation_prompt
