# CheckToolWear.srv - Visual tool wear analysis
# Analyze cutting tool for wear patterns via computer vision

# Request
uint32 tool_number              # Tool number (T1, T2, etc.)
string tool_type                # "end_mill", "drill", "tap", "face_mill", "insert"
float32 tool_diameter           # mm (for reference)
bool capture_new_image          # True to capture, false to use latest
string camera_id                # Tool camera ID
string machine_id
---
# Response
bool success
string message

# Wear assessment
float32 wear_percentage         # 0-100 estimated wear
uint8 CONDITION_NEW = 0
uint8 CONDITION_GOOD = 1
uint8 CONDITION_FAIR = 2
uint8 CONDITION_WORN = 3
uint8 CONDITION_REPLACE = 4
uint8 CONDITION_FAILED = 5
uint8 condition

# Detected wear patterns
VisionDetection[] wear_indicators
string[] wear_types             # "flank_wear", "crater_wear", "edge_chipping", "nose_wear", "built_up_edge"

# Measurements (if calibrated)
float32 flank_wear_mm           # VB measurement
float32 crater_wear_mm          # KT measurement
float32 edge_chipping_percent

# Recommendations
bool replace_recommended
string replacement_reason
float32 estimated_remaining_life  # Percentage 0-100
uint32 estimated_remaining_cycles

# Comparison to baseline (if available)
bool baseline_available
float32 wear_since_baseline_percent
string baseline_image_path

# Evidence
string image_path
string annotated_image_path
float32 inference_time_ms
