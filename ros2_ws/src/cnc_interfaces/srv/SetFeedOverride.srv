# SetFeedOverride.srv - Adjust feed/rapid/spindle overrides

# Request
string machine_id

# Override type
uint8 TYPE_FEED = 0
uint8 TYPE_RAPID = 1
uint8 TYPE_SPINDLE = 2

uint8 override_type

# Value (percentage: 0.1 = 10%, 1.0 = 100%, 2.0 = 200%)
float64 value

# Or use increment (adds/subtracts from current)
bool use_increment false
float64 increment 0.1  # +/- 10%
---
# Response
bool success
string message
float64 previous_value
float64 new_value
