# SafetyReset.srv - Reset safety system

# Request
string machine_id
string operator_id
string reset_code             # Authorization code
bool acknowledge_alarm
string acknowledgement_reason

# Specific reset requests
bool reset_estop
bool reset_interlocks
bool reset_thermal
bool reset_all

---

# Response
bool success
string message
cnc_interfaces/SafetyState current_state
string[] remaining_conditions # Conditions still preventing reset
bool machine_ready            # True if machine can resume
