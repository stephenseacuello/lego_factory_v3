# PlanPath.srv - Request motion path planning

# Request
string machine_id
geometry_msgs/Pose start_pose
geometry_msgs/Pose goal_pose

# Planning constraints
float32 max_velocity          # mm/min
float32 max_acceleration      # mm/s²
float32 clearance_distance    # mm - minimum distance to obstacles

# Planning options
string algorithm              # "linear", "rrt", "prm", "spline"
bool optimize                 # Run path optimization
string optimization_goal      # "time", "distance", "smoothness"
bool check_collisions
float32 timeout               # seconds

# Obstacles (simplified for CNC)
geometry_msgs/Point[] obstacle_points
float32[] obstacle_radii

---

# Response
bool success
string message
cnc_interfaces/PathPlan path
float32 planning_time         # seconds
