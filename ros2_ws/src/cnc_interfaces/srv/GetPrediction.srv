# GetPrediction.srv - Request predictive maintenance analysis

# Request
string machine_id
string component_id           # "spindle", "x_axis", "all"

# Analysis parameters
uint32 history_hours          # Hours of historical data to analyze
bool include_recommendations
bool run_all_models

---

# Response
bool success
string message
cnc_interfaces/PredictiveMaintenance[] predictions
cnc_interfaces/ToolWear[] tool_predictions
builtin_interfaces/Time analysis_timestamp
float32 analysis_duration     # seconds
