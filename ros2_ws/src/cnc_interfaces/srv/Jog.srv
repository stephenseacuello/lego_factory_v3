# Jog.srv - Manual jog movement

# Request
string machine_id

# Movement type
uint8 TYPE_CONTINUOUS = 0  # Jog until stop command
uint8 TYPE_INCREMENTAL = 1 # Move fixed distance
uint8 TYPE_ABSOLUTE = 2    # Move to absolute position

uint8 jog_type

# Target (interpretation depends on jog_type)
float64 x 0.0
float64 y 0.0
float64 z 0.0
float64 a 0.0

# Speed
float64 feed_rate 1000.0  # mm/min
bool rapid false          # Use rapid rate

# Safety
bool check_limits true
---
# Response
bool success
string message
bool motion_complete  # For incremental/absolute moves
float64 final_x
float64 final_y
float64 final_z
