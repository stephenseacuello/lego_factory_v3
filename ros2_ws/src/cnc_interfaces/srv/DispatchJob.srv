# DispatchJob.srv - Dispatch a job to the best available machine
# Request a machine assignment based on job requirements and dispatch strategy

# Request
string job_id
string work_order_id
string part_number
string[] required_capabilities    # e.g., ["milling", "drilling"]
float32 estimated_cycle_time      # seconds
uint8 priority                    # 0=low, 1=normal, 2=high, 3=urgent

# Dispatch strategy constants
uint8 STRATEGY_ROUND_ROBIN = 0
uint8 STRATEGY_LEAST_LOADED = 1
uint8 STRATEGY_HIGHEST_OEE = 2
uint8 STRATEGY_SHORTEST_QUEUE = 3
uint8 STRATEGY_MANUAL = 4

uint8 strategy
string preferred_machine          # Optional hint for MANUAL strategy
---
# Response
bool success
string assigned_machine           # Machine ID assigned
string message
uint32 queue_position            # Position in machine's queue
float32 estimated_start_time     # Seconds from now
