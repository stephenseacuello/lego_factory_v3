# ScanBarcode.srv - Trigger barcode scan

# Request
string scanner_id
string machine_id
uint8 context                 # CONTEXT_* from BarcodeReading.msg
float32 timeout               # seconds
bool verify_database          # Cross-check with MES

---

# Response
bool success
string message
cnc_interfaces/BarcodeReading reading
bool verified
string[] actions_taken        # "part_loaded", "tool_verified", etc.
