# SendGcode.srv - Send G-code command(s)

# Request
string machine_id
string gcode          # Single line or multiple lines (newline separated)
bool wait_complete true   # Wait for motion to complete
float64 timeout 30.0  # Timeout in seconds
---
# Response
bool success
string message
string response       # Controller response (ok, error, etc.)
uint32 lines_sent     # Number of lines processed
uint32 lines_ok       # Lines that returned 'ok'
string[] errors       # Any error messages
