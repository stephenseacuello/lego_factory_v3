# TrainModel.action - Train ML model for predictive maintenance

# Goal
string model_type             # "tool_wear", "bearing", "anomaly", "thermal"
string machine_id             # Train for specific machine or "all"
string[] training_bag_paths   # ROS bag files for training
uint32 epochs
float32 validation_split
string hyperparameters_json   # JSON-encoded hyperparameters

---

# Result
bool success
string message
string model_id
string model_path
float32 accuracy
float32 precision
float32 recall
float32 f1_score
float32 training_time         # seconds
string metrics_json           # Detailed metrics as JSON

---

# Feedback
uint32 current_epoch
uint32 total_epochs
float32 progress              # 0.0-1.0
float32 current_loss
float32 current_accuracy
float32 validation_loss
float32 validation_accuracy
string status_message
