# ExecuteGcode.action - Long-running G-code program execution
# Actions are for tasks that take time and need progress feedback

# ============= Goal =============
string machine_id
string gcode_program          # Full G-code program (multi-line)
string file_path ""           # Or path to .nc/.gcode file
bool dry_run false            # Parse only, don't execute
float64 feed_override 1.0     # Initial feed override (1.0 = 100%)
---
# ============= Result =============
bool success
string message
uint32 lines_executed
uint32 lines_total
float64 execution_time        # Total time in seconds
string[] errors               # Any errors encountered
string final_state            # Machine state after execution
---
# ============= Feedback =============
uint32 current_line
uint32 total_lines
float32 progress_percent      # 0.0 to 100.0
string current_gcode          # Line being executed
float64 elapsed_time
float64 estimated_remaining

# Current position
float64 x
float64 y
float64 z

# Machine state during execution
string machine_state          # "running", "holding", etc.
float64 feed_rate
float64 spindle_speed
