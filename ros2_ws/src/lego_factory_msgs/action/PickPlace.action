# Pick and place action
# Goal
string robot_id
geometry_msgs/Pose pick_pose
geometry_msgs/Pose place_pose
float64 approach_height
float64 velocity_scaling
int32 repeat_count
---
# Result
bool success
int32 cycles_completed
float64 total_time
string message
---
# Feedback
string current_phase      # approaching_pick, picking, lifting, moving, placing, returning
int32 current_cycle
int32 total_cycles
float64 progress_pct
