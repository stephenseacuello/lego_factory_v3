<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cnc_vision</name>
  <version>1.0.0</version>
  <description>
    Computer vision package for CNC SCADA using Roboflow YOLO.
    Provides defect detection, tool wear monitoring, part position verification,
    and safety zone monitoring.
  </description>
  <maintainer email="stephen@example.com">Stephen Acuello</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- ROS2 dependencies -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>cnc_interfaces</depend>

  <!-- Camera drivers -->
  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>usb_cam</exec_depend>

  <!-- Python dependencies (installed via pip in Docker) -->
  <!-- roboflow, inference-sdk, opencv-python, paho-mqtt -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
