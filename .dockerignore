# -------------------------
# Git
# -------------------------
.git
.gitignore

# -------------------------
# macOS / OS junk
# -------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# -------------------------
# Editors / IDEs
# -------------------------
.idea/
.vscode/
*.swp
*.swo

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# -------------------------
# Node / Frontend
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Build artifacts
# -------------------------
dist/
build/
*.egg-info/
*.whl

# -------------------------
# Big caches / outputs you DON'T want baked into images
# -------------------------
**/.cache/
**/cache/
**/logs/
**/log/
**/wandb/
**/runs/
**/outputs/
**/output/
**/artifacts/
**/tmp/
**/temp/

# -------------------------
# ML heavy folders in THIS repo (these were making images huge)
# -------------------------
services/ml/checkpoints/
services/ml/training_outputs/

# Common ML file types
**/*.ckpt
**/*.pt
**/*.pth
**/*.onnx
**/*.npz
**/*.npy
**/*.h5
**/*.pkl

# -------------------------
# Optional: big media in builds (remove these lines if you truly need them in image)
# -------------------------
**/*.mp4
**/*.mov
**/*.mkv
**/*.zip
**/*.tar
**/*.tar.gz

# -------------------------
# IMPORTANT: keep these in build context
# -------------------------
!requirements.txt
!Dockerfile
!docker-compose.yml

